<?xml version="1.0" encoding="utf-8"?>
<!-- Resumo exibido no topo da lista de medicamentos -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/SaudeConecta.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/verde_escuro"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/branco"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/aviso_medicamentos"
            android:textColor="@color/branco_translucido"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFarmacias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status"
            android:backgroundTint="@color/verde_medio"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:textColor="@color/branco"
            android:textSize="13sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_unidades"
            app:drawableTint="@color/branco" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
