<?xml version="1.0" encoding="utf-8"?>
<!-- Relatórios do gestor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinza_claro"
    android:orientation="vertical"
    tools:context=".activities.RelatoriosActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/SaudeConecta.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/nav_relatorios" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/SaudeConecta.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                app:strokeColor="@color/borda"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SaudeConecta.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/relatorio_indicadores" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/relatorio_descricao"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grupoPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip7dias"
                            style="@style/SaudeConecta.ChipFiltro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_7" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip30dias"
                            style="@style/SaudeConecta.ChipFiltro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_30" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip90dias"
                            style="@style/SaudeConecta.ChipFiltro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/periodo_90" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/tvPeriodo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/containerResumo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGerarPdf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:enabled="false"
                        android:text="@string/gerar_relatorio_pdf"
                        app:icon="@drawable/ic_pdf"
                        app:iconGravity="textStart"
                        app:iconTint="@color/branco" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="8dp"
                android:text="@string/relatorio_lgpd"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="@color/verde_medio" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
