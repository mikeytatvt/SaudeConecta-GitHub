<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SaudeConecta" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_escuro</item>
        <item name="colorPrimaryVariant">@color/verde_profundo</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/verde_medio</item>
        <item name="colorSecondaryVariant">@color/verde_escuro</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorError">@color/erro</item>
        <item name="colorControlActivated">@color/verde_escuro</item>
        <item name="android:colorBackground">@color/cinza_claro</item>
        <item name="android:windowBackground">@color/cinza_claro</item>
        <item name="android:statusBarColor">@color/verde_escuro</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/texto_primario</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SaudeConecta.Small</item>
        <item name="materialButtonStyle">@style/Widget.SaudeConecta.Button</item>
        <item name="textInputStyle">@style/Widget.SaudeConecta.TextInput</item>
    </style>

    <style name="ShapeAppearance.SaudeConecta.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Botão verde com cantos arredondados (banner: "Confirmar agendamento" / "Ver detalhes") -->
    <style name="Widget.SaudeConecta.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.SaudeConecta.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/verde_escuro</item>
        <item name="strokeColor">@color/verde_escuro</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.SaudeConecta.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/verde_escuro</item>
        <item name="hintTextColor">@color/verde_escuro</item>
        <item name="startIconTint">@color/verde_medio</item>
        <item name="endIconTint">@color/verde_medio</item>
        <item name="boxBackgroundColor">@color/branco</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- Card branco com sombra suave -->
    <style name="SaudeConecta.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/branco</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Barra superior verde -->
    <style name="SaudeConecta.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/verde_escuro</item>
        <item name="titleTextColor">@color/branco</item>
        <item name="navigationIconTint">@color/branco</item>
        <item name="titleTextAppearance">@style/SaudeConecta.ToolbarTitle</item>
    </style>

    <style name="SaudeConecta.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/branco</item>
    </style>

    <style name="SaudeConecta.SectionTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde_escuro</item>
    </style>

    <style name="SaudeConecta.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/branco</item>
        <item name="chipStrokeColor">@color/verde_medio</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/verde_escuro</item>
        <item name="chipIconTint">@color/verde_escuro</item>
    </style>
</resources>
